# EAS Build: copy of .gitignore (EAS reads this file instead of every .gitignore). Keep both in step.
# Dependencies
node_modules

# Build output
dist
web-build
*.tsbuildinfo

# Cloudflare (local D1 data, wrangler cache) and local secrets
.wrangler
.dev.vars
.env
.env*.local

# Expo / React Native: native folders are generated by `expo prebuild` / EAS
.expo
expo-env.d.ts
apps/mobile/ios
apps/mobile/android
.kotlin/
*.orig.*
.metro-health-check*

# Signing keys and store credentials (never commit)
google-play-service-account*.json
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# Misc
backups
*.log
.DS_Store
Thumbs.db

# Claude Code agent worktrees
.claude/worktrees

# --- EAS only ---
# EAS uses this file instead of .gitignore when it uploads the repo for a mobile build.
# The web app and API are not part of the mobile build.
apps/web/public
docs/design
