{
  "name": "@app/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx --yes expo-doctor@latest",
    "eas:login": "npx --yes eas-cli@latest login",
    "eas:init": "npx --yes eas-cli@latest init",
    "build:ios": "npx --yes eas-cli@latest build -p ios --profile production --auto-submit",
    "build:android": "npx --yes eas-cli@latest build -p android --profile production",
    "build:apk": "npx --yes eas-cli@latest build -p android --profile preview",
    "submit:ios": "npx --yes eas-cli@latest submit -p ios --profile production --latest",
    "submit:android": "npx --yes eas-cli@latest submit -p android --profile production --latest"
  },
  "dependencies": {
    "@app/shared": "*",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
