{
  "name": "@app/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node -e \"const fs=require('fs');fs.mkdirSync('../web/dist',{recursive:true});if(!fs.existsSync('.dev.vars'))fs.copyFileSync('.dev.vars.example','.dev.vars')\"",
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:new": "wrangler d1 migrations create DB",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@app/shared": "*",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.161.0"
  }
}
