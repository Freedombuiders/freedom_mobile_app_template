{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Worker name = the *.workers.dev subdomain and the name in the Cloudflare dashboard.
  "name": "freedom-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Pick the account when your login can see several (or set CLOUDFLARE_ACCOUNT_ID).
  // "account_id": "<your account id>",

  // One Worker serves both the web app and the API on one origin (no CORS, cookies just work):
  // /api/* runs the Worker, everything else is the React build in apps/web/dist (SPA fallback to index.html).
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  // Custom domain (the zone must be in this Cloudflare account). Uncomment after you add the domain:
  // "routes": [
  //   { "pattern": "example.com", "custom_domain": true },
  //   { "pattern": "api.example.com", "custom_domain": true }
  // ],

  // D1 (SQLite). `npm run cf:setup` creates the database and writes its id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freedom-app-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Daily housekeeping (expired sessions, rate-limit rows). Cron times are UTC: 17:00 UTC = 00:00 Vietnam.
  "triggers": { "crons": ["0 17 * * *"] },
  "observability": { "enabled": true },

  // Plain settings. Secrets go through `npx wrangler secret put NAME` (prod) and `.dev.vars` (local), never here.
  "vars": {
    "APP_ENV": "production"
  }
}
